#include <windows.h>
#include "version.h"
1 ICON "dynamo.ico"
1 RT_MANIFEST "app.manifest"
APODLL RCDATA "../build/DynamoAPO.dll"
VS_VERSION_INFO VERSIONINFO
FILEVERSION DYN_VERSION_RC
PRODUCTVERSION DYN_VERSION_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "FileDescription", "Dynamo - compresseur et egaliseur audio"
      VALUE "ProductName", "Dynamo"
      VALUE "FileVersion", DYN_VERSION_STR
      VALUE "ProductVersion", DYN_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x40C, 1200
  END
END
