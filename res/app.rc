#include <windows.h>
#include "version.h"
1 ICON "dynamo.ico"
1 RT_MANIFEST "app.manifest"
FONT_SERIF RCDATA "fonts/InstrumentSerif-Regular.ttf"
FONT_SERIF_I RCDATA "fonts/InstrumentSerif-Italic.ttf"
FONT_MONO RCDATA "fonts/IBMPlexMono-Medium.ttf"
FONT_MONO_SB RCDATA "fonts/IBMPlexMono-SemiBold.ttf"
FONT_BLACK RCDATA "fonts/ArchivoBlack-Regular.ttf"
FONT_LOGO RCDATA "fonts/Unbounded-Bold.ttf"
VS_VERSION_INFO VERSIONINFO
FILEVERSION DYN_VERSION_RC
PRODUCTVERSION DYN_VERSION_RC
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040C04B0"
    BEGIN
      VALUE "CompanyName", "Kozzzmo"
      VALUE "FileDescription", "Kinetik KDYN-10 - compresseur et egaliseur audio"
      VALUE "InternalName", "Dynamo"
      // ProductName reste "Dynamo" : nom interne verifie par le systeme de mise a jour des versions deja installees
      VALUE "OriginalFilename", "Dynamo.exe"
      VALUE "LegalCopyright", "Copyright (C) 2026 Kozzzmo"
      VALUE "ProductName", "Dynamo"
      VALUE "FileVersion", DYN_VERSION_STR
      VALUE "ProductVersion", DYN_VERSION_STR
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x40C, 1200
  END
END
